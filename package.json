{
  "name": "dunya",
  "version": "1.0.0",
  "type": "module",
  "description": "Discord bot for syncing forum discussions to database.",
  "author": "Star Inc.",
  "homepage": "https://starinc.xyz",
  "license": "MIT",
  "main": "app.ts",
  "scripts": {
    "dev": "bun --watch app.ts",
    "start": "bun app.ts",
    "lint": "npx lint-staged",
    "lint:es": "eslint \"*.ts\" \"src/**/*.ts\"",
    "lint:es:fix": "eslint \"*.ts\" \"src/**/*.ts\" --fix",
    "prepare": "husky",
    "db:migrate": "sequelize-cli db:migrate",
    "db:migrate:undo": "sequelize-cli db:migrate:undo",
    "db:migrate:status": "sequelize-cli db:migrate:status"
  },
  "lint-staged": {
    "*.ts": "eslint"
  },
  "dependencies": {
    "@langchain/core": "^1.1.38",
    "@langchain/openai": "^1.4.1",
    "@tavily/core": "^0.7.2",
    "commander": "^15.0.0",
    "discord.js": "^14.13.0",
    "dotenv": "^17.4.0",
    "got": "^15.0.0",
    "http-status-codes": "^2.3.0",
    "itty-router": "^5.0.24",
    "jsonwebtoken": "^9.0.3",
    "langchain": "^1.2.39",
    "mysql2": "^3.7.1",
    "nanoid": "^6.0.1",
    "openweather-api-node": "^3.1.5",
    "quickjs-emscripten": "^0.32.0",
    "sequelize": "^6.35.2",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.0.2",
    "@commitlint/config-conventional": "^21.0.2",
    "@eslint/js": "^9.20.0",
    "@types/bun": "^1.3.11",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^26.1.0",
    "cz-conventional-changelog": "^3.3.0",
    "eslint": "^9.20.0",
    "eslint-plugin-jsdoc": "^64.2.1",
    "husky": "^9.1.7",
    "lint-staged": "^17.0.2",
    "sequelize-cli": "^6.6.5",
    "typescript-eslint": "^8.26.0"
  },
  "config": {
    "commitizen": {
      "path": "./node_modules/cz-conventional-changelog"
    }
  }
}
